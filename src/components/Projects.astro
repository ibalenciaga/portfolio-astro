---
import TechlonolyCard from './cards/TechlonolyCard.astro'
import MoreInfo from './icons/MoreInfo.astro'
---

<section id="projects" class="flex gap-20 justify-center mb-24 ps-24 pe-24">
    <div class="w-full justify-center lg:w-[800px]">
        <h2 class="mb-10 flex flex-row justify-center items-center">
            <span class="text-6xl md:text-5xl ms-2 font-bold text-cyan-400 drop-shadow-[0_0_15px_rgba(6,182,212,0.8)]"
                >Proyectos</span
            >
        </h2><div class="flex flex-col gap-y-16">
            <article
                class="flex flex-col space-x-0 items-start justify-start text-left space-y-8 group md:flex-row md:space-x-8 md:space-y-0"
            >
                <div class="w-full md:w-1/2">
                    <div
                        class="relative flex flex-col items-center col-span-6 row-span-5 gap-8 transition duration-500 ease-in-out transform overflow-clip rounded-xl border-2 border-cyan-500/30 bg-gray-900/40 backdrop-blur-sm md:group-hover:-translate-y-2 md:group-hover:shadow-[0_0_30px_rgba(6,182,212,0.4)] md:group-hover:border-cyan-400/50"
                    >
                        <img
                            alt="Imagen del proyecto Elkartea"
                            class="object-cover object-top w-full md:h-56 rounded-2xl transition duration-500 sm:h-full md:scale-110 md:group-hover:scale-105"
                            loading="lazy"
                            src="../../public/img/projects/elkartea-app.webp"
                        />
                    </div>
                </div>
                <div class="w-full md:w-1/2 md:max-w-lg">
                    <h3 class="text-2xl font-bold text-cyan-400">Elkartea</h3>
                    <div class="flex flex-wrap mt-2">
                        <ul class="flex flex-wrap mb-2 gap-2">
                            <li>
                                <TechlonolyCard title="Php" />
                            </li>
                            <li>
                                <TechlonolyCard title="Symfony" />
                            </li>
                            <li>
                                <TechlonolyCard title="Api" />
                            </li>
                            <li>
                                <TechlonolyCard title="Vuejs" />
                            </li>
                            <li>
                                <TechlonolyCard title="Astro" />
                            </li>
                            <li>
                                <TechlonolyCard title="Tailwind" />
                            </li>
                            <li>
                                <TechlonolyCard title="Mysql" />
                            </li>
                            <li>
                                <TechlonolyCard title="Github" />
                            </li>
                        </ul>
                        <div class="mt-2 justify-start">
                            <p class="text-4xl md:text-base">
                                Aplicación para la gestión de sociedades gastronómicas. Tiene la posibilidad de
                                administrar la información de los socios, las reservas y consumiciones, ver el estado
                                del almacén con el stock de productos y ver estadísticas con datos objetivos de la
                                sociedad.
                            </p>
                        </div>
                        <footer class="flex mt-4">
                            <a
                                href="https://elkartea.com"
                                target="_blank"
                                type="button"
                                class="bg-gradient-to-r from-cyan-500 to-blue-600 text-gray-900 font-bold px-6 py-3 rounded-lg text-5xl md:text-sm hover:from-cyan-400 hover:to-blue-500 transition-all duration-300 shadow-[0_0_20px_rgba(6,182,212,0.6)] hover:shadow-[0_0_30px_rgba(6,182,212,0.8)] hover:scale-105"
                            >
                                <span class="">+ info</span>
                            </a>
                        </footer>
                    </div>
                </div>
            </article>
        </div>
    </div>
</section>
