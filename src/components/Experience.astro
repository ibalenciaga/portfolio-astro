---
import ExperienceItem from '../components/ExperienceItem.astro'
import BriefcaseIcon from './icons/BriefcaseIcon.astro'

import { EXPERIENCE } from '../store/experienceStore.ts'
---

<section id="experience" class="flex gap-20 justify-center mb-24 ps-24 pe-24">
    <div class="w-full justify-center lg:w-[800px]">
        <h2 class="mb-10 flex flex-row justify-center items-center" style="font-family: 'Orbitron', sans-serif;">
            <span class="text-6xl md:text-5xl font-black tracking-tight">
                <span class="text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 via-purple-400 to-pink-400 drop-shadow-[0_0_20px_rgba(168,85,247,0.6)]">EXPERIENCIA</span>
            </span>
        </h2>
        <ol class="relative border-s-2 border-purple-500/30 shadow-[0_0_10px_rgba(168,85,247,0.3)]">
            {
                EXPERIENCE.map((experience) => (
                    <li class={`ms-4 mb-32 sm:mb-10 text-left transition ${experience?.show}`}>
                        <ExperienceItem {...experience} />
                    </li>
                ))
            }
        </ol>
        {}
        <button
            id="showMoreButton"
            class="bg-gradient-to-r from-purple-600/20 via-indigo-600/20 to-purple-600/20 backdrop-blur-xl border-2 border-purple-500/50 text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 to-purple-400 font-bold px-8 py-4 text-5xl md:text-sm hover:border-purple-400 hover:shadow-[0_0_30px_rgba(168,85,247,0.6)] transition-all duration-300 rounded-xl relative overflow-hidden group" style="font-family: 'Orbitron', sans-serif;"
            ><span class="absolute inset-0 bg-gradient-to-r from-transparent via-white/20 to-transparent -translate-x-full group-hover:translate-x-full transition-transform duration-1000"></span><span class="relative z-10">▸ CARGAR MÁS</span></button
        >
    </div>
</section>

<script type="module">
    import { toggleExperiences } from '../../public/functions.js'

    document.querySelector('#showMoreButton').addEventListener('click', toggleExperiences)
</script>
