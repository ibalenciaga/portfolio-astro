---
import ExperienceItem from '../components/ExperienceItem.astro'
import BriefcaseIcon from './icons/BriefcaseIcon.astro'

import { EXPERIENCE } from '../store/experienceStore.ts'
---

<section id="experience" class="flex gap-20 justify-center mb-24 ps-24 pe-24">
    <div class="w-full justify-center lg:w-[800px]">
        <h2 class="mb-10 flex flex-row justify-center items-center" style="font-family: 'Orbitron', sans-serif;">
            <span class="text-6xl md:text-5xl font-black tracking-tight">
                <span
                    class="text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 via-purple-400 to-pink-400 drop-shadow-[0_0_20px_rgba(168,85,247,0.6)]"
                    >EXPERIENCIA</span
                >
            </span>
        </h2>
        <ol class="relative border-s-2 border-purple-500/30 shadow-[0_0_10px_rgba(168,85,247,0.3)]">
            {
                EXPERIENCE.map((experience) => (
                    <li class={`ms-4 mb-32 sm:mb-10 text-left transition ${experience?.show}`}>
                        <ExperienceItem {...experience} />
                    </li>
                ))
            }
        </ol>
        {}
        <button
            id="showMoreButton"
            class="text-5xl md:text-sm py-2 px-5 font-bold text-black bg-gradient-to-r from-cyan-400 via-purple-400 to-pink-400 hover:from-cyan-300 hover:via-purple-300 hover:to-pink-300 rounded-xl transition-all duration-300 shadow-[0_0_20px_rgba(168,85,247,0.6)] hover:shadow-[0_0_30px_rgba(168,85,247,0.8)] relative z-10"
            style="font-family: 'Orbitron', sans-serif;">▸ CARGAR MÁS</button
        >
    </div>
</section>

<script type="module">
    import { toggleExperiences } from '../../public/functions.js'

    document.querySelector('#showMoreButton').addEventListener('click', toggleExperiences)
</script>
