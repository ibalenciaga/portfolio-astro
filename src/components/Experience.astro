---
import ExperienceItem from '../components/ExperienceItem.astro'
import BriefcaseIcon from './icons/BriefcaseIcon.astro'

import { EXPERIENCE } from '../store/experienceStore.ts'
---

<section id="experience" class="flex gap-20 justify-center mb-32 px-6 md:px-24">
    <div class="w-full justify-center lg:w-[900px]">
        <h2 class="mb-16 flex flex-row justify-center items-center">
            <span class="text-5xl md:text-6xl font-light tracking-tight text-black">Experiencia</span>
        </h2>
        <ol class="relative border-s-2 border-gray-300">
            {
                EXPERIENCE.map((experience) => (
                    <li class={`ms-4 mb-32 sm:mb-10 text-left transition ${experience?.show}`}>
                        <ExperienceItem {...experience} />
                    </li>
                ))
            }
        </ol>
        {}
        <button
            id="showMoreButton"
            class="bg-black text-white px-8 py-3 rounded-full text-sm font-medium hover:bg-gray-800 transition-all duration-300 shadow-md hover:shadow-lg"
            >Ver más experiencias</button
        >
    </div>
</section>

<script type="module">
    import { toggleExperiences } from '../../public/functions.js'

    document.querySelector('#showMoreButton').addEventListener('click', toggleExperiences)
</script>
