---
import SocialMedia from '../components/SocialMedia.astro'
---

<section class="mb-32 px-6 md:px-24 py-16">
    <div class="flex flex-col items-center text-center max-w-4xl mx-auto space-y-8">
        <div class="relative">
            <img
                class="rounded-full size-32 md:size-40 ring-4 ring-gray-200 ring-offset-4 shadow-xl"
                src="../../public/img/foto-perfil-recortada.webp"
                alt="Iñaki Balenciaga"
            />
        </div>
        <div class="space-y-4">
            <span class="text-2xl md:text-xl text-gray-600 font-light tracking-wide">Hola, soy</span>
            <h1 class="text-6xl md:text-7xl font-bold text-black leading-tight tracking-tight">Iñaki Balenciaga</h1>
            <h2 class="text-3xl md:text-4xl text-gray-800 font-light tracking-wide">
                Desarrollador <span class="font-semibold border-b-4 border-black pb-1">Full Stack</span>
            </h2>
        </div>
        <div class="pt-4">
            <SocialMedia />
        </div>
    </div>
</section>
