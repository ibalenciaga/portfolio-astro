---
import SocialMedia from '../components/SocialMedia.astro'
---

<section class="mb-36 ps-24 pe-24">
    <div class="flex flex-col md:flex-row mb-5 items-center">
        <div class="flex self-center">
            <img
                class="rounded-full size-48 ring-4 ring-cyan-500/50 shadow-[0_0_30px_rgba(6,182,212,0.5)]"
                src="../../public/img/foto-perfil-recortada.webp"
                alt="Iñaki Balenciaga"
            />
        </div>
        <div class="flex-col align-middle ms-8 ps-8>">
            <span class="text-4xl md:text-5xl mb-5 text-gray-400">Hola, soy</span>
            <h1 class="text-7xl md:text-6xl font-bold bg-gradient-to-r from-cyan-400 via-blue-500 to-purple-600 bg-clip-text text-transparent">Iñaki Balenciaga</h1>
            <h2 class="text-5xl md:text-3xl d-block font-bold mb-6 flex justify-center flex-row gap-2">
                <span class="text-gray-300">Desarrollador</span> <span class="text-cyan-400 animate-pulse drop-shadow-[0_0_10px_rgba(6,182,212,0.8)]">Full Stack</span>
            </h2>
            <SocialMedia />
        </div>
    </div>
</section>
