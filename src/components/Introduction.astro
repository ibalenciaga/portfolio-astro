---
import SocialMedia from '../components/SocialMedia.astro'
---

<section class="mb-36 ps-24 pe-24">
    <div class="flex flex-col md:flex-row mb-5 items-center gap-12">
        <div class="flex self-center relative" style="animation: float 6s ease-in-out infinite;">
            <!-- Holographic rings -->
            <div class="absolute inset-0 rounded-full border-2 border-cyan-400/30 animate-ping"></div>
            <div class="absolute inset-0 rounded-full border-2 border-purple-400/30 animate-ping" style="animation-delay: 0.5s;"></div>
            <div class="absolute -inset-4 bg-gradient-to-r from-cyan-500 via-purple-500 to-pink-500 rounded-full blur-2xl opacity-30 animate-pulse"></div>
            <img
                class="rounded-full size-48 relative z-10 border-4 border-transparent bg-gradient-to-r from-cyan-400 via-purple-400 to-pink-400 p-1 shadow-[0_0_50px_rgba(168,85,247,0.8)]"
                src="../../public/img/foto-perfil-recortada.webp"
                alt="Iñaki Balenciaga"
            />
        </div>
        <div class="flex-col text-center md:text-left">
            <span class="text-3xl md:text-xl mb-3 block font-light tracking-widest" style="font-family: 'Orbitron', sans-serif;">
                <span class="text-transparent bg-clip-text bg-gradient-to-r from-cyan-300 to-purple-300">▸ INICIANDO SISTEMA...</span>
            </span>
            <h1 class="text-7xl md:text-6xl font-black mb-3 tracking-tight" style="font-family: 'Orbitron', sans-serif;">
                <span class="text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 via-purple-400 to-pink-400 drop-shadow-[0_0_30px_rgba(168,85,247,0.8)]">IÑAKI</span><br/>
                <span class="text-transparent bg-clip-text bg-gradient-to-r from-pink-400 via-purple-400 to-cyan-400 drop-shadow-[0_0_30px_rgba(168,85,247,0.8)]">BALENCIAGA</span>
            </h1>
            <h2 class="text-4xl md:text-3xl font-bold mb-6 tracking-wide" style="font-family: 'Orbitron', sans-serif;">
                <span class="text-purple-300">&lt;</span>
                <span class="text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 to-purple-400 animate-pulse">FULL STACK</span>
                <span class="text-purple-300">/&gt;</span>
            </h2>
            <div class="text-cyan-300 text-sm mb-6 font-light tracking-wider">
                <span class="inline-block w-2 h-2 bg-cyan-400 rounded-full animate-pulse mr-2"></span>
                STATUS: ONLINE • EXPERIENCE: 5Y
            </div>
            <SocialMedia />
        </div>
    </div>
</section>
