---
import SocialMedia from '../components/SocialMedia.astro'
---

<section class="mb-36 ps-24 pe-24">
    <div
        class="flex flex-col md:flex-row mb-5 items-center bg-white/40 backdrop-blur-xl border border-white/50 shadow-2xl rounded-3xl p-10"
    >
        <div class="flex self-center">
            <img
                class="rounded-full size-48 ring-8 ring-white/60 shadow-2xl"
                src="../../public/img/foto-perfil-recortada.webp"
                alt="Iñaki Balenciaga"
            />
        </div>
        <div class="flex-col align-middle ms-8 ps-8>">
            <span class="text-4xl md:text-5xl mb-5 text-gray-600">Hola, soy</span>
            <h1
                class="text-7xl md:text-6xl font-bold bg-gradient-to-r from-purple-600 via-pink-500 to-blue-600 bg-clip-text text-transparent"
            >
                Iñaki Balenciaga
            </h1>
            <h2 class="text-5xl md:text-3xl d-block font-bold mb-6 flex justify-center flex-row gap-2">
                <span class="text-gray-700">Desarrollador</span>
                <span class="bg-gradient-to-r from-purple-600 to-pink-600 bg-clip-text text-transparent"
                    >Full Stack</span
                >
            </h2>
            <SocialMedia />
        </div>
    </div>
</section>
