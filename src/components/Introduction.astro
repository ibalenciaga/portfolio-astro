---
import SocialMedia from '../components/SocialMedia.astro'
---

<section class="mb-36 ps-24 pe-24">
    <div class="flex flex-col md:flex-row mb-5 items-center gap-8 bg-[#1e1e1e] p-8 border border-[#2d2d30] font-mono text-left">
        <!-- Números de línea -->
        <div class="hidden md:block text-[#858585] text-sm mr-4 select-none">
            <div>1</div>
            <div>2</div>
            <div>3</div>
            <div>4</div>
            <div>5</div>
            <div>6</div>
            <div>7</div>
            <div>8</div>
            <div>9</div>
        </div>
        
        <div class="flex flex-col md:flex-row items-center gap-8 flex-1">
            <div class="flex self-center">
                <img
                    class="rounded-lg size-48 border-2 border-[#007acc] shadow-lg"
                    src="../../public/img/foto-perfil-recortada.webp"
                    alt="Iñaki Balenciaga"
                />
            </div>
            <div class="flex-col text-left flex-1">
                <div class="mb-2">
                    <span class="text-[#c586c0]">import</span> <span class="text-[#9cdcfe]">Developer</span> <span class="text-[#c586c0]">from</span> <span class="text-[#ce9178]">'@/profiles'</span><span class="text-[#d4d4d4]">;</span>
                </div>
                <div class="mb-4">
                    <span class="text-[#c586c0]">const</span> <span class="text-[#9cdcfe]">developer</span> <span class="text-[#d4d4d4]">=</span> <span class="text-[#c586c0]">new</span> <span class="text-[#4ec9b0]">Developer</span><span class="text-[#d4d4d4]">()</span><span class="text-[#d4d4d4]">;</span>
                </div>
                <h1 class="text-5xl md:text-4xl font-bold mb-2">
                    <span class="text-[#9cdcfe]">developer</span><span class="text-[#d4d4d4]">.</span><span class="text-[#dcdcaa]">name</span> <span class="text-[#d4d4d4]">=</span> <span class="text-[#ce9178]">"Iñaki Balenciaga"</span><span class="text-[#d4d4d4]">;</span>
                </h1>
                <h2 class="text-3xl md:text-xl mb-4">
                    <span class="text-[#9cdcfe]">developer</span><span class="text-[#d4d4d4]">.</span><span class="text-[#dcdcaa]">role</span> <span class="text-[#d4d4d4]">=</span> <span class="text-[#ce9178]">"</span><span class="text-[#4ec9b0] font-bold">Full Stack</span><span class="text-[#ce9178]">"</span><span class="text-[#d4d4d4]">;</span>
                </h2>
                <div class="text-sm text-[#858585] mb-3">
                    <span class="text-[#6a9955]">// Status: Online • 5 years experience</span>
                </div>
                <SocialMedia />
            </div>
        </div>
    </div>
</section>
