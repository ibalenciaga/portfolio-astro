---
import LinkedInIcon from './icons/LinkedInIcon.astro'
import GithubIcon from './icons/GithubIcon.astro'
import MailIcon from './icons/MailIcon.astro'
---

<section class="flex gap-10 justify-center">
    <div class="flex flex-col items-center">
        <div class="inline-flex rounded-md shadow-sm" role="group">
            <a
                href="https://www.linkedin.com/in/ibalenciaga/"
                target="_blank"
                type="button"
                class="inline-flex items-center px-6 py-3 text-5xl md:text-sm font-medium bg-white text-black border-2 border-gray-200 rounded-full hover:border-black hover:shadow-md transition-all duration-300"
            >
                <LinkedInIcon />
                <span class="ms-2">LinkedIn</span>
            </a>
            <a
                href="https://github.com/ibalenciaga"
                target="_blank"
                type="button"
                class="inline-flex items-center px-6 py-3 text-5xl md:text-sm font-medium bg-white text-black border-2 border-gray-200 rounded-full hover:border-black hover:shadow-md transition-all duration-300 ml-3"
            >
                <GithubIcon />
                <span class="ms-2">Github</span>
            </a>
            <a
                href="mailto:ibalenciaga@gmail.com"
                class="inline-flex items-center px-6 py-3 text-5xl md:text-sm font-medium bg-white text-black border-2 border-gray-200 rounded-full hover:border-black hover:shadow-md transition-all duration-300 ml-3"
            >
                <MailIcon />
                <span class="ms-2">Enviar email</span>
            </a>
        </div>
    </div>
</section>
