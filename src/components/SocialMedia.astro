---
import LinkedInIcon from './icons/LinkedInIcon.astro'
import GithubIcon from './icons/GithubIcon.astro'
import MailIcon from './icons/MailIcon.astro'
---

<section class="flex gap-10 justify-center">
    <div class="flex flex-col items-center">
        <div class="inline-flex rounded-md shadow-sm" role="group">
            <a
                href="https://www.linkedin.com/in/ibalenciaga/"
                target="_blank"
                type="button"
                class="inline-flex items-center px-4 py-2 text-5xl md:text-sm font-medium bg-purple-900/40 backdrop-blur-lg border-2 border-purple-400/40 rounded-s-2xl text-white hover:bg-purple-800/50 hover:border-purple-400/70 transition-all duration-300 shadow-lg hover:shadow-purple-500/50"
            >
                <LinkedInIcon />
                <span class="ms-2">LinkedIn</span>
            </a>
            <a
                href="https://github.com/ibalenciaga"
                target="_blank"
                type="button"
                class="inline-flex items-center px-4 py-2 text-5xl md:text-sm font-medium bg-purple-900/40 backdrop-blur-lg border-y-2 border-purple-400/40 text-white hover:bg-purple-800/50 hover:border-purple-400/70 transition-all duration-300 shadow-lg hover:shadow-purple-500/50"
            >
                <GithubIcon />
                <span class="ms-2">Github</span>
            </a>
            <a
                href="mailto:ibalenciaga@gmail.com"
                class="inline-flex items-center px-4 py-2 text-5xl md:text-sm font-medium bg-purple-900/40 backdrop-blur-lg border-2 border-purple-400/40 rounded-e-2xl text-white hover:bg-purple-800/50 hover:border-purple-400/70 transition-all duration-300 shadow-lg hover:shadow-purple-500/50"
            >
                <MailIcon />
                <span class="ms-2">Enviar email</span>
            </a>
        </div>
    </div>
</section>
