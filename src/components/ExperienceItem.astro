---
const { date, title, description, technologies, freelance } = Astro.props
import TechlonolyCard from './cards/TechlonolyCard.astro'
---

<div class="absolute w-4 h-4 bg-cyan-400 rounded-full mt-1.5 -start-2 border-2 border-gray-900 shadow-[0_0_10px_rgba(6,182,212,0.8)]"></div>
<article class="md:flex md:flex-row bg-gray-900/40 backdrop-blur-sm border border-cyan-500/20 p-6 rounded-lg hover:border-cyan-500/40 hover:shadow-[0_0_20px_rgba(6,182,212,0.2)] transition-all duration-300">
    <div class="md:flex md:flex-col min-w-[300px] mb-5 ps-2">
        <h3 class="text-5xl md:text-xl mt-10 mb-5 md:m-0 font-semibold text-cyan-400">{title}</h3>
        <time class="text-3xl md:text-sm mb-5 md:mb-0 md:m-0 font-normal leading-none text-gray-400">{date}</time>
        <p class="text-4xl md:text-base mb-5 md:m-0 font-normal text-purple-400">{freelance}</p>
        <div class="flex flex-wrap gap-5 md:gap-1 mt-1">
            {technologies.map((technology: string) => <TechlonolyCard title={technology} />)}
        </div>
    </div>
    <div class="ps-5">
        <span class="text-4xl md:text-base mb-5 font-normal text-gray-300" set:html={description} />
    </div>
</article>
