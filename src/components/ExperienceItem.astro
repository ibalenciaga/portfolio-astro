---
const { date, title, description, technologies, freelance } = Astro.props
import TechlonolyCard from './cards/TechlonolyCard.astro'
---

<div class="absolute w-4 h-4 bg-black rounded-full mt-2 -start-2 border-4 border-white shadow-md"></div>
<article class="md:flex md:flex-row hover:bg-gray-50 p-6 rounded-2xl transition-all duration-300 group">
    <div class="md:flex md:flex-col min-w-[300px] mb-6 md:mb-0">
        <h3 class="text-5xl md:text-2xl mb-3 md:mb-2 font-semibold text-black group-hover:text-gray-900">{title}</h3>
        <time class="text-3xl md:text-sm mb-3 md:mb-2 font-light text-gray-600">{date}</time>
        <p class="text-4xl md:text-sm mb-4 md:mb-3 font-medium text-gray-800">{freelance}</p>
        <div class="flex flex-wrap gap-2 mt-2">
            {technologies.map((technology: string) => <TechlonolyCard title={technology} />)}
        </div>
    </div>
    <div class="md:ps-8 md:border-l-2 md:border-gray-200">
        <span class="text-4xl md:text-base font-light text-gray-700 leading-relaxed" set:html={description} />
    </div>
</article>
