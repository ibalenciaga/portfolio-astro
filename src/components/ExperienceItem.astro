---
const { date, title, description, technologies, freelance } = Astro.props
import TechlonolyCard from './cards/TechlonolyCard.astro'
---

<div class="absolute w-4 h-4 bg-gradient-to-r from-cyan-400 to-purple-400 rounded-full mt-2 -start-2 shadow-[0_0_15px_rgba(168,85,247,0.8)] animate-pulse"></div>
<article class="md:flex md:flex-row bg-gradient-to-br from-purple-900/20 via-indigo-900/20 to-purple-900/20 backdrop-blur-xl border border-purple-500/30 p-6 mb-4 rounded-xl hover:border-purple-400/60 hover:shadow-[0_0_30px_rgba(168,85,247,0.3)] transition-all duration-500 group relative overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-r from-transparent via-purple-500/5 to-transparent -translate-x-full group-hover:translate-x-full transition-transform duration-1000"></div>
    <div class="md:flex md:flex-col min-w-[300px] mb-5 ps-2 relative z-10">
        <h3 class="text-5xl md:text-xl mb-3 font-bold tracking-wide" style="font-family: 'Orbitron', sans-serif;">
            <span class="text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 to-purple-400">{title}</span>
        </h3>
        <time class="text-3xl md:text-sm mb-3 font-medium text-purple-300">{date}</time>
        <p class="text-4xl md:text-base mb-3 font-semibold text-transparent bg-clip-text bg-gradient-to-r from-pink-400 to-purple-400">{freelance}</p>
        <div class="flex flex-wrap gap-2 mt-2">
            {technologies.map((technology: string) => <TechlonolyCard title={technology} />)}
        </div>
    </div>
    <div class="ps-5 relative z-10">
        <span class="text-4xl md:text-base font-normal text-indigo-200" set:html={description} />
    </div>
</article>
