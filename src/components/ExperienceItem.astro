---
const { date, title, description, technologies, freelance } = Astro.props
import TechlonolyCard from './cards/TechlonolyCard.astro'
---

<div class="absolute w-2 h-2 bg-[#007acc] rounded-full mt-2 -start-1 border-2 border-[#1e1e1e]"></div>
<article
    class="md:flex md:flex-row bg-[#252526] border border-[#2d2d30] p-6 mb-4 hover:bg-[#2d2d2d] hover:border-[#007acc]/50 transition-all duration-300 font-mono"
>
    <div class="md:flex md:flex-col min-w-[300px] mb-5">
        <div class="text-[#6a9955] text-xs mb-1">// Project</div>
        <h3 class="text-5xl md:text-lg mb-2 font-semibold">
            <span class="text-[#9cdcfe]">title</span><span class="text-[#d4d4d4]">:</span>
            <span class="text-[#ce9178]">"{title}"</span><span class="text-[#d4d4d4]">,</span>
        </h3>
        <time class="text-3xl md:text-sm mb-2 text-[#b5cea8]">
            <span class="text-[#9cdcfe]">date</span><span class="text-[#d4d4d4]">:</span>
            <span class="text-[#ce9178]">"{date}"</span><span class="text-[#d4d4d4]">,</span>
        </time>
        <p class="text-4xl md:text-sm mb-3 text-[#4ec9b0]">
            <span class="text-[#9cdcfe]">type</span><span class="text-[#d4d4d4]">:</span>
            <span class="text-[#ce9178]">"{freelance}"</span><span class="text-[#d4d4d4]">,</span>
        </p>
        <div class="text-[#6a9955] text-xs mb-1">// Stack</div>
        <div class="flex flex-wrap gap-2">
            <span class="text-[#9cdcfe]">stack</span><span class="text-[#d4d4d4]">: [</span>
            <div class="flex flex-wrap gap-1 ml-2">
                {technologies.map((technology: string) => <TechlonolyCard title={technology} />)}
            </div>
            <span class="text-[#d4d4d4]">]</span>
        </div>
    </div>
    <div class="md:ps-6 md:border-l-2 md:border-[#2d2d30]">
        <div class="text-[#6a9955] text-xs mb-2">/* Description */</div>
        <span class="text-4xl md:text-sm text-[#d4d4d4]" set:html={description} />
    </div>
</article>
